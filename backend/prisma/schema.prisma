generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  comments    Comment[]
  memberships ProjectMember[]
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String
  ownerId     String
  videos      Video[]
  members     ProjectMember[]
  shareToken String? @unique
  createdAt   DateTime @default(now())
}

model Video {
  id        String   @id @default(uuid())
  title     String
  url       String
  duration  Float
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  annotations Annotation[]
  comments    Comment[]
  createdAt   DateTime @default(now())
}

model Annotation {
  id        String   @id @default(uuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  time      Float
  strokes   Json
  color     String
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  time      Float
  text      String
  x         Float?
  y         Float?
  createdAt DateTime @default(now())
}

model ProjectMember {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  role      String   @default("viewer")

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
}